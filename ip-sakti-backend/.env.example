SERVER_PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/ipsakti?sslmode=disable
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...   # optional — reserved for future use
OPENAI_API_KEY=sk-...          # optional — reserved for future embeddings
